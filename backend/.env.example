# Copy this file to .env to configure an LLM provider for parsing & explanation.
# The app works fully WITHOUT any provider configured — a deterministic
# rule-based parser and template-based explanation are used by default.

LLM_PROVIDER=none      # none | anthropic | ollama

# Required only if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Required only if LLM_PROVIDER=ollama — must match a model you've pulled
# locally (e.g. `ollama pull llama3.1:8b`). Ollama must be running on the
# default port (localhost:11434).
OLLAMA_MODEL=llama3.1:8b

# Port the backend server listens on
PORT=4000
